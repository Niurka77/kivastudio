# ============================================================
# Variables de entorno de desarrollo
# Copia este archivo a `.env` y completa los valores reales.
# NUNCA subas `.env` al repositorio (ver .gitignore y 02 §15.10).
# ============================================================

# URL pública del sitio (dominio canónico en producción)
PUBLIC_SITE_URL=http://localhost:4321

# Supabase — credenciales del proyecto (Dashboard > Settings > API)
# La clave publishable/anon es PÚBLICA y puede exponerse al navegador (RLS).
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=

# Número de WhatsApp de la marca (formato internacional, solo dígitos)
PUBLIC_WHATSAPP_NUMBER=51927726414

# Emails autorizados como admin (separados por coma). Deben existir como
# usuarios en Supabase Auth (Dashboard > Authentication > Users > Add user).
# `PUBLIC_ADMIN_EMAILS` es la misma lista para el navegador (solo gating de UI).
# ROLES: la PRIMERA dirección es la dueña (owner, p. ej. Kaili) y puede eliminar
# productos; el resto son editoras (p. ej. Dayna), solo crean y editan.
ADMIN_EMAILS=kaili@example.com,dayna@example.com
PUBLIC_ADMIN_EMAILS=kaili@example.com,dayna@example.com

# --- SECRETO (SOLO servidor, NUNCA público) -------------------
# Service role de Supabase. Úsalo exclusivamente en Server Endpoints
# (panel admin del servidor) para escribir con permisos. No lo expongas a la UI.
# SUPABASE_SERVICE_ROLE_KEY=

# Secreto para firmar los tokens de acceso a los medios privados
# (video de bienvenida y foto de la artesana). Genera uno largo y aleatorio:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
PRIVATE_MEDIA_SECRET=

# Token de lectura/escritura del store privado de Vercel Blob (medios privados).
# Se crea con `vercel blob create-store <name> --access private --yes` y el CLI
# lo añade automáticamente a los entornos de Vercel.
# BLOB_READ_WRITE_TOKEN=