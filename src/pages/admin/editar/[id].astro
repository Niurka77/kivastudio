---
import AdminLayout from '@/layouts/AdminLayout.astro';
import AdminGate from '@/components/admin-gate';
import ProductEditForm from '@/islands/product-edit-form';

export const prerender = false;

const { id } = Astro.params;
---

<AdminLayout title="Editar producto · Admin · Kiva Studio">
  {id ? (
    <AdminGate client:load>
      <header>
        <h1 class="font-heading text-3xl font-bold text-foreground sm:text-4xl">
          Editar producto
        </h1>
        <p class="mt-2 text-muted-foreground">
          Modifica los datos de la pieza. Los cambios se guardan en Supabase y se
          reflejan en la tienda al instante.
        </p>
      </header>
      <div class="mt-8 rounded-lg border border-border bg-background p-6 shadow-soft sm:p-8">
        <ProductEditForm client:load productId={id} />
      </div>
    </AdminGate>
  ) : (
    <p class="py-10 text-center text-muted-foreground">
      Falta el id del producto a editar.
    </p>
  )}
</AdminLayout>