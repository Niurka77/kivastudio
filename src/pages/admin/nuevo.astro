---
import AdminLayout from '@/layouts/AdminLayout.astro';
import AdminGate from '@/components/admin-gate';
import ProductForm from '@/islands/product-form';
---

<AdminLayout title="Nuevo producto · Admin · Kiva Studio" active="new">
  <AdminGate client:load>
    <header>
      <h1 class="font-heading text-3xl font-bold text-foreground sm:text-4xl">
        Nuevo producto
      </h1>
      <p class="mt-2 text-muted-foreground">
        Crea una pieza para tu catálogo. Se guarda en Supabase y aparece en la
        tienda automáticamente.
      </p>
    </header>
    <div
      class="mt-8 rounded-lg border border-border bg-background p-6 shadow-soft sm:p-8"
    >
      <ProductForm client:load />
    </div>
  </AdminGate>
</AdminLayout>