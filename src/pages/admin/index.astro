---
import Layout from '@/layouts/Layout.astro';
import AdminGate from '@/components/admin-gate';
import AdminProductsList from '@/islands/admin-products-list';
import AdminSignOut from '@/islands/admin-sign-out';
---

<Layout title="Admin · Kiva Studio">
  <main class="mx-auto max-w-3xl px-4 py-14 sm:px-6">
    <div class="flex flex-wrap items-center justify-between gap-4">
      <div>
        <a
          href="/"
          class="text-sm font-medium text-primary-strong underline-offset-4 hover:underline"
        >
          ← Volver a la tienda
        </a>
        <h1 class="mt-2 font-heading text-3xl font-bold text-foreground sm:text-4xl">
          Panel de administración
        </h1>
        <p class="mt-2 text-muted-foreground">Gestiona el catálogo de Kiva Studio.</p>
      </div>
      <AdminSignOut client:load />
    </div>

    <div
      class="mt-8 rounded-lg border border-border bg-background p-6 shadow-soft sm:p-8"
    >
      <AdminGate client:load>
        <AdminProductsList client:load />
      </AdminGate>
    </div>
  </main>
</Layout>
