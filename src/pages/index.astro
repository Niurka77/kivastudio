---
import Layout from '@/layouts/Layout.astro';
import Navbar from '@/islands/Navbar';
import Hero from '@/components/hero.astro';
import Footer from '@/components/footer.astro';
import About from '@/components/about.astro';
import Contact from '@/components/contact.astro';
import Testimonials from '@/components/testimonials.astro';
import InstagramSection from '@/components/instagram-section.astro';
import Faq from '@/components/faq.astro';
import ProductCatalog from '@/islands/product-catalog';
import CartDrawer from '@/components/cart-drawer';
import WelcomeVideo from '@/islands/WelcomeVideo';
import VideosSection from '@/islands/VideosSection';
import { getSupabaseServiceClient } from '@/lib/supabase/server';
import { PRODUCTS } from '@/data/products';
import type { SectionKey, SiteSection } from '@/types';

export const prerender = false;

const supabase = getSupabaseServiceClient();
const { data: sectionRows } = await supabase
  .from('sections')
  .select('*')
  .eq('active', true)
  .order('key', { ascending: true });

const sections: Partial<Record<SectionKey, SiteSection>> = {};
for (const row of sectionRows ?? []) {
  const key = row.key as SectionKey;
  sections[key] = {
    id: row.id,
    key,
    title: row.title,
    subtitle: row.subtitle,
    backgroundUrl: row.background_url,
    textAlign: (row.text_align as SiteSection['textAlign']) ?? null,
    decorationLeft: row.decoration_left,
    decorationRight: row.decoration_right,
    active: row.active,
    createdAt: row.created_at,
    updatedAt: row.updated_at,
  };
}

// Si aún no existe la tabla de secciones (migración 0005 pendiente), la portada
// sigue funcionando con los textos por defecto.
const heroSection = sections['hero'];
const welcomeSection = sections['welcome'];
const videosSection = sections['videos'];
const productsSection = sections['products'];
const aboutSection = sections['about'];
const testimonialsSection = sections['testimonials'];
const instagramSection = sections['instagram'];
const contactSection = sections['contact'];
const faqSection = sections['faq'];
const footerSection = sections['footer'];
---

<Layout
  title="Inicio"
  description="Kiva Studio · Estudio artesanal de crochet en Perú. Amigurumi, bolsos, ropa y accesorios tejidos a mano, únicos y con dedicación. Pedidos personalizados por WhatsApp."
>
  <Navbar client:load />

  <CartDrawer client:load />

  <main>
    <Hero section={heroSection} />

    <WelcomeVideo client:load section={welcomeSection} />

    <VideosSection client:load section={videosSection} />

    <ProductCatalog client:load products={PRODUCTS} section={productsSection} />

    <About section={aboutSection} />

    <Testimonials section={testimonialsSection} />

    <InstagramSection section={instagramSection} />

    <Faq section={faqSection} />

    <Contact section={contactSection} />
  </main>

  <Footer section={footerSection} />
</Layout>