---
import Layout from '@/layouts/Layout.astro';
import Navbar from '@/islands/Navbar';
import Hero from '@/components/hero.astro';
import Footer from '@/components/footer.astro';
import About from '@/components/about.astro';
import Contact from '@/components/contact.astro';
import Testimonials from '@/components/testimonials.astro';
import InstagramSection from '@/components/instagram-section.astro';
import ProductCatalog from '@/islands/product-catalog';
import CartDrawer from '@/components/cart-drawer';
import { PRODUCTS } from '@/data/products';
---

<Layout
  title="Inicio"
  description="Kiva Studio · Estudio artesanal de crochet en Perú. Amigurumi, bolsos, ropa y accesorios tejidos a mano, únicos y con dedicación. Pedidos personalizados por WhatsApp."
>
  <Navbar client:load />

  <CartDrawer client:load />

  <main>
    <Hero />

    <ProductCatalog client:load products={PRODUCTS} />

    <About />

    <Testimonials />

    <InstagramSection />

    <Contact />
  </main>

  <Footer />
</Layout>
