---
import Layout from '@/layouts/Layout.astro';
import Navbar from '@/islands/Navbar';
import Hero from '@/components/hero.astro';
import Footer from '@/components/footer.astro';
import About from '@/components/about.astro';
import ProductCatalog from '@/islands/product-catalog';
import CartDrawer from '@/components/cart-drawer';
import { PRODUCTS } from '@/data/products';
---

<Layout title="Inicio">
  <Navbar client:load />

  <CartDrawer client:load />

  <main>
    <Hero />

    <ProductCatalog client:load products={PRODUCTS} />

    <About />

    <section id="contacto" class="mx-auto max-w-6xl px-4 py-20 sm:px-6">
      <h2 class="font-heading text-3xl font-bold text-foreground sm:text-4xl">
        Contáctanos
      </h2>
      <p class="mt-2 max-w-xl text-muted-foreground">
        Haz pedidos personalizados directamente por WhatsApp o por Instagram.
      </p>
    </section>
  </main>

  <Footer />
</Layout>
