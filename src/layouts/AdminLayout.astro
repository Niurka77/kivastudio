---
import Layout from '@/layouts/Layout.astro';
import AdminSession from '@/islands/admin-session';
import AdminNav from '@/islands/admin-nav';
import Logo from '@/components/Logo.astro';

interface Props {
  title: string;
  active?: string;
}

const { title, active } = Astro.props;
---

<Layout title={title}>
  <div class="min-h-dvh lg:grid lg:grid-cols-[240px_1fr]">
    <aside class="border-b border-border bg-background lg:border-b-0 lg:border-r">
      <div class="lg:sticky lg:top-0 lg:h-dvh lg:px-6 lg:py-8">
        <div class="px-5 pt-4 lg:px-0 lg:pt-0">
          <a href="/" class="inline-block" aria-label="Kiva Studio - inicio">
            <Logo />
          </a>
        </div>

        <AdminNav client:load active={active} />

        <div class="mt-4 hidden px-0 lg:block">
          <AdminSession client:load />
        </div>
      </div>
    </aside>

    <main class="mx-auto w-full max-w-4xl px-4 py-10 sm:px-6">
      <slot />
    </main>
  </div>
</Layout>