---
import Layout from '@/layouts/Layout.astro';
import AdminSession from '@/islands/admin-session';
import Logo from '@/components/Logo.astro';

interface Props {
  title: string;
  active?: 'dashboard' | 'orders' | 'new' | 'reviews' | 'posts';
}

const { title, active } = Astro.props;

const links = [
  { href: '/admin', id: 'dashboard', label: 'Panel' },
  { href: '/admin/pedidos', id: 'orders', label: 'Pedidos' },
  { href: '/admin/resenas', id: 'reviews', label: 'Reseñas' },
  { href: '/admin/novedades', id: 'posts', label: 'Novedades' },
  { href: '/admin/nuevo', id: 'new', label: 'Nuevo producto' },
] as const;

const activeSet = new Set([active]);
---

<Layout title={title}>
  <div class="min-h-dvh lg:grid lg:grid-cols-[240px_1fr]">
    <aside class="border-b border-border bg-background lg:border-b-0 lg:border-r">
      <div class="lg:sticky lg:top-0 lg:h-dvh lg:px-6 lg:py-8">
        <div class="px-5 pt-4 lg:px-0 lg:pt-0">
          <a href="/" class="inline-block" aria-label="Kiva Studio - inicio">
            <Logo />
          </a>
        </div>

        <nav class="mt-2 flex items-center gap-1 overflow-x-auto px-5 pb-3 lg:mt-8 lg:flex-col lg:items-stretch lg:gap-1 lg:overflow-visible lg:px-0 lg:pb-0">
          {links.map((l) => (
            <a
              href={l.href}
              class:list={[
                'whitespace-nowrap rounded-[12px] px-3 py-2 text-sm font-semibold transition-colors',
                activeSet.has(l.id)
                  ? 'bg-primary/10 text-primary-strong'
                  : 'text-muted-foreground hover:bg-secondary hover:text-foreground',
              ]}
            >
              {l.label}
            </a>
          ))}
          <a
            href="/"
            class="whitespace-nowrap rounded-[12px] px-3 py-2 text-sm font-semibold text-muted-foreground transition-colors hover:bg-secondary hover:text-foreground"
          >
            Ver tienda
          </a>
        </nav>

        <div class="mt-4 hidden px-0 lg:block">
          <AdminSession client:load />
        </div>
      </div>
    </aside>

    <main class="mx-auto w-full max-w-4xl px-4 py-10 sm:px-6">
      <slot />
    </main>
  </div>
</Layout>