---
interface Props {
  image?: string;
  name?: string;
}

const { image, name = 'La artesana detrás de Kiva Studio' } = Astro.props;
---

<div class="flex flex-col items-center rounded-[24px] bg-background p-8 shadow-soft">
  {
    image ? (
      <img
        src={image}
        alt={name}
        width={224}
        height={224}
        class="h-56 w-56 rounded-full object-cover shadow-soft"
      />
    ) : (
      <div
        class="flex h-56 w-56 flex-col items-center justify-center gap-3 rounded-full bg-gradient-to-br from-primary-soft to-primary/20"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          class="h-12 w-12 text-primary-strong"
        >
          <circle cx="12" cy="8" r="4" />
          <path d="M4 20c0-3.3 3.6-5.5 8-5.5s8 2.2 8 5.5" stroke-linecap="round" />
        </svg>
        <span class="max-w-[10rem] px-4 text-center text-xs font-medium leading-snug text-muted-foreground">
          Foto de la artesana · próximamente
        </span>
      </div>
    )
  }
  <p class="mt-4 text-sm font-semibold text-foreground">{name}</p>
</div>
