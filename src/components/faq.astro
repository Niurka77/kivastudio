---
import TypingTitle from '@/islands/TypingTitle';
import FaqAccordion from '@/islands/faq-accordion';
---

<section id="preguntas" class="bg-secondary">
  <div class="mx-auto max-w-6xl px-4 py-20 sm:px-6">
    <header class="mx-auto max-w-2xl text-center">
      <p class="text-sm font-semibold uppercase tracking-wider text-primary-strong">
        Preguntas frecuentes
      </p>
      <TypingTitle
        client:visible
        text="Resolvemos tus dudas"
        tag="h2"
        className="mt-2 text-3xl sm:text-4xl"
      />
      <p class="mt-3 text-lg text-muted-foreground">
        Todo sobre pedidos, envíos, personalización y cuidados de tus piezas de
        crochet.
      </p>
    </header>

    <div class="mt-10">
      <FaqAccordion client:load />
    </div>
  </div>
</section>