---
import Logo from '@/components/Logo.astro';
import TypingTitle from '@/islands/TypingTitle';
import SectionDecor from '@/components/SectionDecor.astro';
import {
  hasSectionBg,
  sectionAlign,
  sectionAlignClass,
  sectionBgCss,
  sectionSubtitle,
  sectionTitle,
} from '@/lib/sections';
import type { SiteSection } from '@/types';

interface Props {
  section?: SiteSection;
}

const { section } = Astro.props;
const align = sectionAlign(section);
---

<section
  id="nosotros"
  class="relative overflow-hidden bg-secondary"
  style={sectionBgCss(section?.backgroundUrl)}
>
  {hasSectionBg(section?.backgroundUrl) && (
    <div class="absolute inset-0 z-0 bg-background/60" aria-hidden="true" />
  )}
  <SectionDecor left={section?.decorationLeft} right={section?.decorationRight} />
  <div class="relative z-10 mx-auto max-w-6xl px-4 py-20 sm:px-6">
    <div class="grid items-center gap-10 md:grid-cols-[1fr_1.2fr]">
      <div class="flex justify-center md:justify-start">
        <Logo className="h-44 w-auto" />
      </div>

      <div class={sectionAlignClass(align)}>
        <TypingTitle
          client:visible
          text={sectionTitle(section, 'Hecho con el corazón')}
          tag="h2"
          className="text-3xl sm:text-4xl"
        />
        {sectionSubtitle(section) ? (
          <p class="mt-4 text-lg leading-relaxed text-muted-foreground">
            {section?.subtitle}
          </p>
        ) : (
          <>
            <p class="mt-4 text-lg leading-relaxed text-muted-foreground">
              Kiva Studio nace del trabajo de una artesana que teje con las manos y con
              el corazón. Ama lo que hace: crea piezas de crochet y, muy a menudo, las
              regala a los demás, incluso sin cobrarlas, pensando siempre en los demás
              antes que en sí misma.
            </p>
            <p class="mt-3 text-lg leading-relaxed text-muted-foreground">
              Detrás de cada tejido hay una historia de generosidad. Por eso, en esta
              tienda no vendemos "productos": compartimos piezas únicas hechas a mano,
              con tiempo, dedicación y cariño.
            </p>
          </>
        )}
        <p class="mt-3 text-sm font-medium text-primary-strong">
          — Una artesana que siempre piensa en los demás, respaldada por su familia.
        </p>
      </div>
    </div>
  </div>
</section>
