---
/**
 * Ovillo de lana realista hecho 100% con CSS (sin imágenes).
 * Esfera con hilo enrollado (gradientes concéntricos), brillo, sombra 3D,
 * hebras cruzadas y una hebra suelta que cuelga.
 */
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<div class:list={['ovillo', className]}>
  <span class="ovillo-sheen" aria-hidden="true"></span>
  <span class="ovillo-thread" aria-hidden="true"></span>
</div>

<style>
  .ovillo {
    position: relative;
    border-radius: 50%;
    pointer-events: none;
    background:
      radial-gradient(circle at 30% 26%, rgba(255, 255, 255, 0.92) 0%, rgba(255, 255, 255, 0) 44%),
      radial-gradient(circle at 72% 84%, rgba(150, 10, 80, 0.42) 0%, rgba(150, 10, 80, 0) 60%),
      conic-gradient(
        from 30deg,
        transparent 0deg 38deg,
        rgba(255, 255, 255, 0.08) 52deg 96deg,
        transparent 110deg 190deg,
        rgba(120, 0, 60, 0.10) 210deg 280deg,
        transparent 300deg 360deg
      ),
      repeating-radial-gradient(
        circle at 50% 50%,
        rgba(190, 24, 93, 0.26) 0px 2px,
        transparent 2px 6px
      ),
      #f25f9d;
    box-shadow:
      inset -14px -16px 34px rgba(120, 0, 60, 0.38),
      inset 10px 12px 26px rgba(255, 255, 255, 0.22),
      inset 0 0 0 1px rgba(190, 24, 93, 0.25),
      0 26px 50px -18px rgba(190, 24, 93, 0.55),
      0 8px 16px -8px rgba(190, 24, 93, 0.4);
  }

  /* Hebras que cruzan el ovillo (dan el aspecto de hilo enrollado) */
  .ovillo::before,
  .ovillo::after {
    content: '';
    position: absolute;
    inset: -3%;
    border-radius: 50%;
    pointer-events: none;
  }

  .ovillo::before {
    border-top: 5px solid rgba(190, 24, 93, 0.32);
    border-left: 4px solid rgba(255, 255, 255, 0.16);
    transform: rotate(26deg);
  }

  .ovillo::after {
    border-bottom: 5px solid rgba(120, 0, 60, 0.3);
    border-right: 4px solid rgba(255, 255, 255, 0.14);
    transform: rotate(-34deg);
  }

  /* Reflejo brillante del hilo */
  .ovillo-sheen {
    position: absolute;
    top: 16%;
    left: 12%;
    width: 42%;
    height: 22%;
    border-radius: 50%;
    border: 3px solid rgba(255, 255, 255, 0.65);
    transform: rotate(-38deg);
  }

  /* Hebrita suelta que cuelga del ovillo */
  .ovillo-thread {
    position: absolute;
    left: 58%;
    top: 92%;
    width: 44%;
    height: 3px;
    border-radius: 999px;
    background: #f25f9d;
    transform: rotate(-12deg);
    transform-origin: left center;
    box-shadow: 0 1px 0 rgba(120, 0, 60, 0.25);
  }

  .ovillo-thread::after {
    content: '';
    position: absolute;
    left: 88%;
    top: -4px;
    width: 16px;
    height: 12px;
    border-radius: 50%;
    background: radial-gradient(circle at 35% 35%, #f47fb0, #e0498a 70%);
  }
</style>