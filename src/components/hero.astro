---
import Reveal from '@/islands/motion/Reveal';
import TypingTitle from '@/islands/TypingTitle';
import ProtectedImage from '@/islands/ProtectedImage';
import { Button } from '@/components/ui/button';
import { waLink, WHATSAPP_DISPLAY } from '@/lib/whatsapp';
---

<section id="inicio" class="overflow-hidden bg-secondary">
  <div
    class="mx-auto grid max-w-6xl gap-10 px-4 py-16 sm:px-6 md:grid-cols-2 md:items-center md:py-24"
  >
    <Reveal client:load y={24}>
      <span
        class="inline-flex items-center gap-2 rounded-full bg-primary-soft/60 px-4 py-1.5 text-sm font-semibold text-primary-strong"
      >
        Hecho a mano · Crochet artesanal
      </span>
      <TypingTitle
        client:load
        text="Piezas tejidas a mano, con amor"
        accentFrom={23}
        className="mt-5 text-4xl sm:text-5xl"
      />
      <p class="mt-4 max-w-md text-lg text-muted-foreground">
        Muñecos amigurumi, accesorios y decoración únicos creados en Kiva Studio. Cada
        pieza lleva tiempo, dedicación y un toque personal.
      </p>
      <div class="mt-8 flex flex-wrap items-center gap-3">
        <a href="#productos">
          <Button size="lg">Ver productos</Button>
        </a>
        <a
          href={waLink('Hola Kiva Studio, me encantó tu trabajo.')}
          target="_blank"
          rel="noopener noreferrer"
        >
          <Button size="lg" variant="outline"> Pedidos por WhatsApp </Button>
        </a>
      </div>
      {
        WHATSAPP_DISPLAY && (
          <p class="mt-6 text-sm text-muted-foreground">
            ¿Ideas personalizadas? Escríbenos al{' '}
            <span class="font-semibold text-primary-strong">{WHATSAPP_DISPLAY}</span>
          </p>
        )
      }
    </Reveal>

    <div class="hidden items-center justify-center md:flex">
      <ProtectedImage
        client:load
        mediaKey="artesana"
        alt="La artesana de Kiva Studio"
        width={900}
        height={671}
        containerClassName="w-full max-w-md rounded-[28px] shadow-soft"
      />
    </div>
  </div>
</section>
