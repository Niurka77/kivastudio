---
import DailyFeed from '@/islands/daily-feed';
import TypingTitle from '@/islands/TypingTitle';
import { InstagramIcon } from '@/components/brand-icons';
import {
  hasSectionBg,
  sectionBgCss,
  sectionSubtitle,
  sectionTitle,
} from '@/lib/sections';
import type { SiteSection } from '@/types';

interface Props {
  section?: SiteSection;
}

const { section } = Astro.props;

const INSTAGRAM_URL = 'https://www.instagram.com/kiva_studio.pe/';
const INSTAGRAM_HANDLE = '@kiva_studio.pe';
---

<section
  id="instagram"
  class:list={['relative', hasSectionBg(section?.backgroundUrl) && 'bg-cover bg-center']}
  style={sectionBgCss(section?.backgroundUrl)}
>
  {hasSectionBg(section?.backgroundUrl) && (
    <div class="absolute inset-0 bg-background/60" aria-hidden="true" />
  )}
  <div class="relative mx-auto max-w-6xl px-4 py-20 sm:px-6">
    <div class="flex flex-col items-start justify-between gap-4 sm:flex-row sm:items-end">
      <div>
        <TypingTitle
          client:visible
          text={sectionTitle(section, 'Sigue el día a día')}
          tag="h2"
          className="text-3xl sm:text-4xl"
        />
        <p class="mt-2 max-w-xl text-muted-foreground">
          {sectionSubtitle(
            section,
            'El avance real de tus pedidos: fotos y videos del proceso, publicados por Kiva Studio.',
          )}
        </p>
      </div>
      <a
        href={INSTAGRAM_URL}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 rounded-[16px] border border-border bg-background px-5 py-2.5 text-sm font-semibold text-primary-strong transition-colors hover:bg-secondary"
      >
        <InstagramIcon className="size-4" aria-hidden="true" />
        {INSTAGRAM_HANDLE}
      </a>
    </div>

    <DailyFeed client:load />
  </div>
</section>