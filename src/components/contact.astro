---
import { MessageCircle } from 'lucide-react';
import { InstagramIcon } from '@/components/brand-icons';
import TypingTitle from '@/islands/TypingTitle';
import KittenWithYarn from '@/components/KittenWithYarn';
import SectionDecor from '@/components/SectionDecor.astro';
import { waLink, WHATSAPP_DISPLAY } from '@/lib/whatsapp';
import {
  hasSectionBg,
  sectionAlign,
  sectionAlignClass,
  sectionBgCss,
  sectionSubtitle,
  sectionTitle,
} from '@/lib/sections';
import type { SiteSection } from '@/types';

interface Props {
  section?: SiteSection;
}

const { section } = Astro.props;
const align = sectionAlign(section);

const INSTAGRAM_URL = 'https://www.instagram.com/kiva_studio.pe/';
const INSTAGRAM_HANDLE = '@kiva_studio.pe';
---

<section
  id="contacto"
  class="relative overflow-hidden bg-secondary"
  style={sectionBgCss(section?.backgroundUrl)}
>
  {hasSectionBg(section?.backgroundUrl) && (
    <div class="absolute inset-0 z-0 bg-background/60" aria-hidden="true" />
  )}
  <SectionDecor left={section?.decorationLeft} right={section?.decorationRight} />
  <div class="relative z-10 mx-auto max-w-6xl px-4 py-20 sm:px-6">
    <div class={['mx-auto max-w-2xl', sectionAlignClass(align)].join(' ')}>
      <KittenWithYarn client:visible className="mx-auto h-28 w-auto sm:h-36" />
      <TypingTitle
        client:visible
        text={sectionTitle(section, '¿Ideas personalizadas?')}
        tag="h2"
        className="mt-4 text-3xl sm:text-4xl"
      />
      <p class="mt-3 text-lg text-muted-foreground">
        {sectionSubtitle(
          section,
          'Escríbenos y tejeremos tu pieza única: colores, nombre y detalles a tu gusto. Respondemos por WhatsApp o Instagram.',
        )}
      </p>

      <div class="mt-8 flex flex-col justify-center gap-3 sm:flex-row">
        {
          WHATSAPP_DISPLAY && (
            <a
              href={waLink('Hola Kiva Studio, me gustaría hacer un pedido personalizado.')}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center gap-2 rounded-[16px] bg-primary px-6 py-3.5 text-sm font-semibold text-primary-foreground transition-transform hover:scale-[1.02]"
            >
              <MessageCircle className="size-5" aria-hidden="true" />
              WhatsApp · {WHATSAPP_DISPLAY}
            </a>
          )
        }
        <a
          href={INSTAGRAM_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center gap-2 rounded-[16px] border border-border bg-background px-6 py-3.5 text-sm font-semibold text-primary-strong transition-colors hover:bg-secondary"
        >
          <InstagramIcon className="size-5" aria-hidden="true" />
          {INSTAGRAM_HANDLE}
        </a>
      </div>
    </div>
  </div>
</section>